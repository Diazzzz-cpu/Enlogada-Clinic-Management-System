# Server Settings
PORT=5000
NODE_ENV=development

# Frontend base URL (used to build links sent in emails, e.g. password reset)
FRONTEND_URL=http://localhost:5173

# Database Settings (Local PostgreSQL)
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enlogada_clinic

# Security Settings
#
# JWT_SECRET is the only thing standing between a stranger and every account in the system.
# Deliberately left BLANK: this file used to ship a working placeholder, and since the setup
# instructions say to base .env on it, any deployment that copied the file without editing this
# line was signing tokens with a string published in the repository. Anyone holding it can mint a
# valid token for any account — including the seeded SuperAdmin.
#
# Generate one per environment, and never share it between them:
#   openssl rand -hex 32
#
# The server refuses to start if this is blank, shorter than 32 characters, or a known example
# value (see src/config/environment.js).
JWT_SECRET=

# How long a session lasts. Was 7d, which is a long time for a token that cannot be revoked
# individually. Authority is re-read from the database on every request and a password change now
# invalidates older tokens, so this is a backstop rather than the main control — but a day still
# covers a working shift without forcing repeated sign-ins.
JWT_EXPIRES_IN=1d

# Tax treatment
#
# Whether the clinic is VAT-registered with the BIR. This is not cosmetic — it changes what a
# senior citizen or PWD actually pays. Under RA 9994 / RA 10754 a VAT-registered establishment
# must treat the sale as VAT-EXEMPT: strip the 12% VAT from the VAT-inclusive price first, then
# apply the 20% discount to that VAT-exempt base.
#
# On a PHP 1,000.00 service the patient pays 714.29 the correct way and 800.00 the flat way, so
# getting this wrong overcharges the patient and understates the deduction the clinic can claim.
#
# Prices in the `tests` table are stored VAT-INCLUSIVE (the shelf price a patient is quoted), so
# VAT is extracted from them rather than added on top. Defaults to true; set to false only for a
# non-VAT establishment, and confirm with your accountant before changing it.
# ENLOGADA IS NOT VAT-REGISTERED — set this to false. Its BIR-registered service invoice reads
# "Non VAT Reg. TIN : 412-980-963-00000" and "THIS DOCUMENT IS NOT VALID FOR CLAIMING INPUT
# TAXES". Left as `true` here only because that is the safer default for an unknown clinic:
# claiming a VAT exemption you are not registered for is worse than not claiming one you are.
# Getting it wrong is 85.71 undercharged per 1,000 on every senior/PWD sale, and no test catches
# it — the specs read this value and adapt to whatever it says.
CLINIC_VAT_REGISTERED=false
VAT_RATE=0.12

# Turnaround targets, in minutes from payment to released report, per department. [1.62.0]
# Drawn as the reference line on the Analytics chart and used for the "within target" rate.
#
# These are a clinic POLICY and nobody here has agreed them yet. The built-in defaults
# (Laboratory 60, Ultrasound 45, Xray 30) are plausible starting values chosen so the chart has a
# benchmark at all — not measurements, and not a commitment. Set the clinic's real figures here
# and no deployment is needed to change them; a table would be the right home once they ARE policy,
# and building one now would dress three guesses up as a decision.
#
# A department left out of the list is measured but not judged: its turnaround is reported and its
# within-target rate comes back empty rather than 0, because "not measured" and "never hit the
# target" are different facts.
# TURNAROUND_TARGETS=Laboratory:60,Ultrasound:45,Xray:30

# Email (Gmail SMTP) — released results, booking confirmations, password resets.
#
# The clinic sends from enlogada2011@gmail.com. Put the address here; put the App Password ONLY
# in your own backend/.env, which is gitignored. Never commit it, never paste it into a ticket,
# a screenshot or a log — anyone holding it can send mail as the clinic.
#
# Getting the App Password (a normal Gmail password will NOT work once 2FA is on):
#   1. Turn on 2-Step Verification on the account.
#   2. Google Account -> Security -> App passwords -> generate one for "Mail".
#   3. Paste the 16 characters below, without the spaces Google displays.
#
# Both halves are required. With only one, the backend keeps working and logs which is missing
# rather than failing once per released result.
#
# EMAIL_USER / EMAIL_APP_PASSWORD / EMAIL_FROM are accepted as aliases, since that is how Google
# names them; SMTP_* wins if both are set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=enlogada2011@gmail.com
SMTP_PASS=
SMTP_FROM=Enlogada Ultrasound & Diagnostic Clinic <enlogada2011@gmail.com>

# Google OAuth 2.0 Credentials
#
# GOOGLE_CLIENT_ID must match VITE_GOOGLE_CLIENT_ID in frontend/.env exactly — it is the
# audience the backend checks each Google ID token against.
#
# GOOGLE_CLIENT_SECRET is not used by the ID-token verification flow this app implements; it
# is kept here only for a future server-side authorization-code flow. Leaving it blank does
# not disable Google Sign-In.
#
# LEAVE BLANK to disable Google Sign-In (login falls back to email/password only).
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Online Payment Gateway — GCash / Maya (PayMongo hosted checkout)
#
# GCash and Maya do not issue direct merchant API credentials to applications; in the
# Philippines you onboard through a BSP-regulated payment processor which exposes them as
# payment methods. PayMongo's hosted Checkout Session redirects the payer to GCash's and
# Maya's own real payment pages.
#
# LEAVE BLANK to disable online payment entirely: the client UI then shows no online option
# and every payment is recorded by the cashier at the counter, exactly as before.
#
# Get these from your own PayMongo dashboard (https://dashboard.paymongo.com):
#   - PAYMONGO_SECRET_KEY: starts sk_test_ for testing, sk_live_ in production. NEVER expose
#     this to the frontend.
#   - PAYMONGO_WEBHOOK_SECRET: shown once when you create the webhook endpoint pointing at
#     POST {your backend}/api/payments/gateway/webhook. Without it, incoming webhooks cannot
#     be verified and no online payment will ever be marked Paid.
#   - PAYMONGO_API_BASE: PayMongo documents checkout_sessions under both /v1 and /v2. Use the
#     version your account's dashboard shows; /v1 is the default.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_API_BASE=https://api.paymongo.com/v1

# ── The clinic's own identity, printed on receipts and the public pages ──────────────────────
#
# All optional. Anything left blank falls back to the values compiled into the frontend
# (frontend/src/lib/clinic.js), so an install that sets none of these still shows the clinic's
# name and address correctly.
#
# These live here rather than in frontend/.env because Vite inlines its env at BUILD time: setting
# the TIN there means editing a file and running `npm run build`, which is not an operation a
# clinic administrator will ever perform. Here it is an edit and a server restart, the same as
# changing the SMTP password.
CLINIC_NAME=
CLINIC_SHORT_NAME=
CLINIC_ADDRESS=
CLINIC_PHONE=
# Printed on the receipt beneath the clinic name. Read by clinicController; was missing from this
# file entirely, so a clinic copying this template got a receipt with no proprietor on it.
CLINIC_PROPRIETOR=
CLINIC_EMAIL=

# The statutory identifiers. LEAVE BLANK until you have the real values.
#
# With these blank the receipt prints as a "Payment Receipt" and states in so many words that it
# is NOT a BIR-registered Official Receipt. That is the honest output, and it is the right one to
# ship with. See CLINIC_ONBOARDING.md for what to ask the clinic for.
#
# What upgrades the wording is CLINIC_PERMIT — the Authority to Print, or the Permit to Use for a
# computerised system — and NOT the TIN. A TIN identifies the taxpayer; it does not authorise
# anyone to issue an official receipt, so a registered clinic without an ATP/PTU still cannot. The
# TIN prints in the header whenever it is set, either way.
#
#   CLINIC_TIN=123-456-789-00000        # BIR Certificate of Registration (Form 2303)
#   CLINIC_PERMIT=ATP-0123456789        # Authority to Print, or PTU for a POS/CAS
#   CLINIC_ACCREDITATION=PHIC-01-234567-8
CLINIC_TIN=
CLINIC_PERMIT=
CLINIC_ACCREDITATION=

# ── SAMPLE VALUES, for reviewing the receipt layout ──────────────────────────────────────────
#
# Uncomment these (and comment out the three blank lines above) to see the receipt with every
# field populated. They are safe to leave in by accident: the app detects an all-zeros or
# "SAMPLE"-worded identifier and prints a dashed red "SAMPLE CONFIGURATION — not valid for issue
# to a patient" band across the top of the document, and refuses to call it an Official Receipt.
#
# That detection is the only reason a sample block exists here at all. Without it the difference
# between a demo machine and a live one would be somebody remembering.
#
#   CLINIC_TIN=000-000-000-00000
#   CLINIC_PERMIT=SAMPLE-NOT-REGISTERED
#   CLINIC_ACCREDITATION=SAMPLE-PHIC-000
CLINIC_SERVICES=LABORATORY • ULTRASOUND • X-RAY
