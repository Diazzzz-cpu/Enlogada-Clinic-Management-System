{
  "name": "enlogada-clinic-backend",
  "version": "1.0.0",
  "description": "Backend API for Enlogada Ultrasound and Diagnostic Clinic Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:watch": "node --test --watch \"tests/unit/*.test.js\"",
    "lint": "oxlint src",
    "retention": "node src/scripts/retention.js",
    "retention:apply": "node src/scripts/retention.js --confirm",
    "clean:e2e": "node src/scripts/cleanE2eData.js",
    "clean:e2e:apply": "node src/scripts/cleanE2eData.js --apply",
    "slots:unlimited": "node src/scripts/cleanE2eData.js --apply --unlimited-slots",
    "slots:restore": "node src/scripts/cleanE2eData.js --apply --restore-slots",
    "reminders": "node src/scripts/sendAppointmentReminders.js",
    "reminders:send": "node src/scripts/sendAppointmentReminders.js --confirm"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "express-rate-limit": "^7.1.5",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.11.3",
    "tesseract.js": "^7.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "oxlint": "^1.78.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true
}
