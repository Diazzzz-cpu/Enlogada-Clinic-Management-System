# Google OAuth 2.0 Client ID for React Frontend
#
# Must be the SAME client ID as GOOGLE_CLIENT_ID in backend/.env — the backend verifies the
# token's audience against its own copy, so a mismatch fails every sign-in with
# "Invalid Google authentication token".
#
# Create it at https://console.cloud.google.com/apis/credentials:
#   Create Credentials > OAuth client ID > Web application, then under
#   "Authorized JavaScript origins" add the exact origin the app is served from:
#     http://localhost:5173      (Vite dev server)
#   No redirect URI is needed: this app uses Google Identity Services' ID-token flow, which
#   never leaves the page.
#
# LEAVE BLANK to disable Google Sign-In: the login page then shows a short notice in place of
# the button and email/password sign-in works exactly as before.
#
# Vite only reads .env at server start — restart `npm run dev` after changing this.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Base URL of the Enlogada backend API, including the /api suffix.
#
# Optional in development — omit it and the app falls back to http://localhost:5000/api, which is
# where `npm run dev` in backend/ serves.
#
# REQUIRED for any build you deploy. Vite inlines this at BUILD time, not at run time, so it must
# be set before `npm run build` — setting it on the server afterwards has no effect. Without it a
# deployed build points every request at the viewer's own machine and every screen comes up empty.
#
# The origin must also appear in the backend's CORS allowlist (FRONTEND_URL or CORS_ORIGINS in
# backend/.env), or the browser will block the responses.
#
#   VITE_API_BASE_URL=https://api.enlogada-clinic.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# The clinic's statutory identifiers — SET THESE IN backend/.env INSTEAD.
#
# They used to live here, and that was the wrong place. Vite inlines this file at BUILD time, so
# entering the clinic's TIN meant editing it and running `npm run build` — which no clinic
# administrator is going to do, and is why the field stayed empty and the receipt kept printing
# "not a BIR-registered Official Receipt" with no practical route to changing it.
#
# The app now reads them from GET /api/clinic at start-up, so the real home is:
#   backend/.env  ->  CLINIC_TIN / CLINIC_PERMIT / CLINIC_ACCREDITATION
# which is an edit and a server restart, the same as changing the SMTP password.
#
# The three variables below are still honoured if set, so an existing build keeps working, but a
# value from the backend wins. Prefer the backend; leave these blank.
VITE_CLINIC_TIN=
VITE_CLINIC_PERMIT=
VITE_CLINIC_ACCREDITATION=
